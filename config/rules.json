{
  "promo_services": ["uber", "uber-eats"],
  "services": [
    {
      "name": "uber",
      "match_sender": "uber",
      "steps": [
        {
          "selector": "td.p2b",
          "regex": "\\b\\d{4}\\b",
          "score": 30
        },
        {
          "selector": "td.p1b",
          "regex": "\\b\\d{4,8}\\b",
          "score": 30
        },
        {
          "selector": "strong",
          "regex": "\\b\\d{4,8}\\b",
          "score": 10
        }
      ]
    },
    {
      "name": "paypal",
      "match_sender": "paypal",
      "steps": [
        {
          "selector": "span.code",
          "regex": "\\b\\d{6}\\b",
          "score": 20
        }
      ]
    },
    {
      "name": "discord",
      "match_sender": "discord",
      "steps": [
        {
          "selector": "td.verification",
          "regex": "\\b\\d{6}\\b",
          "score": 20
        }
      ]
    }
  ]
}
